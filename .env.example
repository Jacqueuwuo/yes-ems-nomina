# Copia este archivo a ".env" para correr el sistema en tu propia computadora.
# En Render, estas mismas variables se configuran desde el panel de
# "Environment" del servicio -- ahi NO se sube un archivo .env, se
# escriben una por una en la pagina web. Ver README.md.

# Puerto en el que corre el servidor (Render lo asigna solo; en tu compu
# puedes dejar 3000).
PORT=3000

# Usuario y contrasena para entrar al panel de administracion (Nomina /
# Asistencia). Cambia la contrasena por una fuerte y unica antes de usar
# el sistema con datos reales.
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# Cadena secreta usada para firmar la sesion de inicio de sesion. Pon
# cualquier texto largo y aleatorio (no tiene que ser memorable).
SESSION_SECRET=cambia-este-texto-por-algo-largo-y-aleatorio

# ---------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------
# En tu computadora NO necesitas tocar nada de esta seccion: si dejas
# TURSO_DATABASE_URL vacio, el sistema guarda todo solo en un archivo
# local (./data/nomina.db).
#
# En Render (o cualquier servidor gratuito cuyo disco se borre al
# reiniciar), llena estas dos variables con los datos de tu base de datos
# gratuita y permanente de Turso (turso.tech). El README.md explica paso
# a paso, sin usar la terminal, como crearla y de donde copiar estos dos
# valores.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Ruta del archivo local de base de datos. Solo se usa cuando
# TURSO_DATABASE_URL esta vacio (es decir, en tu computadora). No hace
# falta cambiarlo.
DB_PATH=./data/nomina.db
